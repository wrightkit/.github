#!/bin/sh
# Compile-check on the declared MSRV so newer-toolchain syntax (for example
# let-chains) fails locally instead of in the CI MSRV job.
set -eu

[ -f Cargo.toml ] || exit 0
toolchain="$("$(dirname "$0")/msrv-toolchain.sh")"
[ -n "$toolchain" ] || exit 0

exec cargo "$toolchain" clippy --workspace --all-targets --all-features -- -D warnings
